# Copy this file to .env.local (git-ignored) and fill the values from
# Supabase dashboard -> Project Settings -> API Keys. Never commit real keys.
#
# The publishable key is designed to be public (it ships in the browser; Row Level Security protects the data).
# NEVER put the secret / service_role key in any VITE_ variable: everything starting with VITE_ is exposed to users.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
