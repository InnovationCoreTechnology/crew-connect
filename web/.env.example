# Copy this file to .env.local (git-ignored) and fill the values from
# Supabase dashboard -> Project Settings -> API Keys. Never commit real keys.
#
# The publishable key is designed to be public (it ships in the browser; Row Level Security protects the data).
# NEVER put the secret / service_role key in any VITE_ variable: everything starting with VITE_ is exposed to users.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
#
# CAPTCHA (Cloudflare Turnstile). The SITE key is public. Leave empty to show no widget (dev only: the server then accepts only
# the dev test numbers). For local testing Cloudflare publishes dummy keys: 1x00000000000000000000AA (always passes).
# The matching SECRET key goes ONLY into Supabase (Edge Functions -> Secrets -> TURNSTILE_SECRET_KEY), never into this file.
VITE_TURNSTILE_SITE_KEY=
